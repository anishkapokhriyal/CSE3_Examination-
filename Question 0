<!DOCTYPE html>
<html>
<head>
    <title>Online Learning Portal</title>
</head>
<body>

    <!-- Main Title -->
    <h1 align="center" style="color: blue;">Online Learning Portal</h1>

    <!-- Top Content Section using Table for Alignment -->
    <table border="0" width="100%" cellpadding="10">
        <tr valign="top">
            <!-- Left Side: Image and Caption -->
            <td align="center" width="35%">
                <img src="learning.png" alt="Online Learning" width="200"><br>
                <font color="blue"><i>Figure 1: Online Learning</i></font>
            </td>
            
            <!-- Right Side: Paragraph and Audio -->
            <td align="left" width="65%">
                <p>
                    Welcome to our online learning portal.<br>
                    We provide high-quality courses in<br>
                    <u>web development</u>, programming and<br>
                    data science.
                </p>
                <p><b>Lecture Audio</b></p>
                <audio controls>
                    <source src="lecture.mp3" type="audio/mpeg">
                    Your browser does not support the audio element.
                </audio>
            </td>
        </tr>
    </table>

    <br>

    <!-- Subheading -->
    <h3>Available Courses</h3>

    <!-- Table of Available Courses -->
    <table border="1" width="100%" cellspacing="0" cellpadding="5">
        <tr bgcolor="#f0f0f0">
            <th>Course Code</th>
            <th>Course Name</th>
            <th>Duration</th>
        </tr>
        <tr align="center">
            <td>WT101</td>
            <td>HTML and CSS</td>
            <td>6 Weeks</td>
        </tr>
        <tr align="center">
            <td>WT102</td>
            <td>JavaScript Basics</td>
            <td>6 Weeks</td>
        </tr>
    </table>

</body>
</html>
